#include <Wire.h>              // Librería de comunicación I2C
#include <Adafruit_GFX.h>      // Librería de gráficos
#include <Adafruit_SSD1306.h>  // Driver de la pantalla

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define NUEVO_SDA 26
#define NUEVO_SCL 25

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

void setup() {
	Serial.begin(115200);
	Wire.begin(NUEVO_SDA, NUEVO_SCL);  // Inicializa I2C con pines específicos

	if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
		Serial.println(F("Error: No se pudo enlazar la pantalla OLED"));
		while (true)
			;
	}
	mostrarBitmap();
}

void loop() {
}

